@page "/configuration/actuators"

@using Microsoft.AspNetCore.SignalR.Client

@using Aporta.Shared.Models.Flex
@using Aporta.Shared.Calls
@using Aporta.Shared.Messaging
@using Aporta.WebClient.Messaging

@inject FlexApiService FlexApi
@inject NavigationManager NavigationManager

<Heading Size="HeadingSize.Is1">Actuators</Heading>
<Divider />

@if (_actuators == null)
{
    <div class="spinner"></div>
}
else
{
    <Row>
        <Column ColumnSize="ColumnSize.Is6.OnDesktop">
            @if (_availableActuators != null && _availableActuators.InstanceList.Any())
            {
                <Button Color="Color.Primary" Clicked="_addOutputModal.Show">Add Actuator</Button>
            }
            else
            {
                <Alert Color="Color.Warning" Visible="true">
                    <AlertMessage>Add Actuator</AlertMessage>
                    <AlertDescription>No available outputs are configured in the drivers</AlertDescription>
                </Alert>
            }
        </Column>
    </Row>
    <Row>
        <Column>
            <Card Margin="Margin.Is4.OnY">
                <CardBody>
                    <Table Striped="true" Narrow="true" ThemeContrast="ThemeContrast.Light">
                        <TableHeader>
                            <TableRow>
                                <TableHeaderCell>Name</TableHeaderCell>
                                <TableHeaderCell></TableHeaderCell>
                            </TableRow>
                        </TableHeader>
                        <TableBody>
                            @foreach (var actuator in _actuators.InstanceList.OrderBy(a => a.Name))
                            {
                                <TableRow>
                                    <TableRowHeader>
                                        @actuator.Name
                                    </TableRowHeader>
                                    <TableRowCell TextAlignment="TextAlignment.End">
                                        <Button Clicked="@(async () => await RemoveActuator(actuator))">
                                            <Icon Name="IconName.Delete" Style="color: red"/>
                                        </Button>
                                    </TableRowCell>
                                </TableRow>
                            }
                        </TableBody>
                    </Table>
                </CardBody>
            </Card>
        </Column>
    </Row>

    <Modal @ref="_addOutputModal">
        <ModalContent Size="ModalSize.Default" Centered="true">
            <ModalHeader>
                <ModalTitle>
                    Add Actuator
                </ModalTitle>
                <CloseButton Clicked="@_addOutputModal.Hide"/>
            </ModalHeader>
            <ModalBody>
                <Validations Mode="ValidationMode.Auto" ValidateOnLoad="false" @ref="_addOutputValidations">
                    <Validation Validator="@ValidationRule.IsNotEmpty" >
                        <Field>
                            <FieldLabel>Name</FieldLabel>
                            <FieldBody>
                                <TextEdit @bind-Text="_addName">
                                    <Feedback>
                                        <ValidationError>
                                            Please enter a name for the actuator
                                        </ValidationError>
                                    </Feedback>
                                </TextEdit>
                            </FieldBody>
                        </Field>
                    </Validation>

                    <Field>
                        <FieldLabel>Device Endpoint</FieldLabel>
                        <FieldBody>
                            <Select TValue="int" @bind-SelectedValue="_addEndpointUnid">
                                @foreach (var available in _availableActuators.InstanceList)
                                {
                                    <SelectItem Value="@available.Unid.Value">@available.Name</SelectItem>
                                }
                            </Select>
                        </FieldBody>
                    </Field>
                </Validations>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary" Clicked="@_addOutputModal.Hide">Cancel</Button>
                <Button Color="Color.Primary" Clicked="@(async () => await AddActuator())">Add</Button>
            </ModalFooter>
        </ModalContent>
    </Modal>
}

<Snackbar @ref="_snackbar" Color="@_snackbarColor">
    <SnackbarBody>
        @_snackbarMessage
    </SnackbarBody>
</Snackbar>

<MessageProvider />

@code {
    [Inject]
    IMessageService MessageService { get; set; }

    private FlexListResponse<FlexDev> _actuators;
    private FlexListResponse<FlexDev> _availableActuators;
    private string _addName;
    private int _addEndpointUnid;

    private HubConnection _hubConnection;

    private Modal _addOutputModal;
    private Validations _addOutputValidations;

    private Snackbar _snackbar;
    private SnackbarColor _snackbarColor;
    private string _snackbarMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _actuators = await FlexApi.GetActuatorListAsync(0, 1000);

        await InitializeAvailableActuators();

        _hubConnection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri(Locations.DataChangeNotification))
            .WithAutomaticReconnect(new SignalRRetryPolicy())
            .Build();
        _hubConnection.On<int>(Methods.OutputInserted, async _ =>
        {
            _actuators = await FlexApi.GetActuatorListAsync(0, 1000);
            await InitializeAvailableActuators();
            StateHasChanged();
        });
        _hubConnection.On<int>(Methods.OutputDeleted, async _ =>
        {
            _actuators = await FlexApi.GetActuatorListAsync(0, 1000);
            await InitializeAvailableActuators();
            StateHasChanged();
        });
        await _hubConnection.StartAsync();
    }

    private async Task InitializeAvailableActuators()
    {
        _availableActuators = await FlexApi.GetAvailableActuatorsAsync();
        _addName = "";
        _addEndpointUnid = _availableActuators.InstanceList.FirstOrDefault()?.Unid ?? 0;
    }

    private async Task AddActuator()
    {
        if (!await _addOutputValidations.ValidateAll())
        {
            return;
        }
        await _addOutputModal.Hide();

        var dev = new FlexDev { Unid = _addEndpointUnid, Name = _addName };
        await FlexApi.SaveActuatorAsync(dev);
    }

    private async Task RemoveActuator(FlexDev actuator)
    {
        if (!await MessageService.Confirm($"Are you sure you want to delete actuator '{actuator.Name}'?", "Delete Actuator", options =>
        {
            options.ShowMessageIcon = false;
            options.ConfirmButtonColor = Color.Danger;
        }))
        {
            return;
        }

        await FlexApi.DeleteActuatorAsync(actuator.Unid.Value);
    }

}
